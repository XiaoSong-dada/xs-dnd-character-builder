# 站点信息（可选，全部不配置时主页署名行自动隐藏）
# 复制本文件为 .env.local 后按需修改；Vite 从 app/ 目录加载 .env*

# 作者名（主页署名行"由 X 制作"）
VITE_AUTHOR_NAME=小宋哒哒

# GitHub 主页或仓库链接（署名行 GitHub 图标跳转地址）
VITE_GITHUB_URL=https://github.com/XiaoSong-dada

# 可选署名标语（暂未展示，预留）
VITE_AUTHOR_TAGLINE=

# 站点公开根 URL（SEO canonical / og:url / sitemap 使用；无尾斜杠，未配置则不输出 canonical）
# 只写到站点入口，不要包含下面的部署前缀：canonical 由「本值 + VITE_BASE_URL + 路由路径」拼出
VITE_SITE_URL=https://your_url
# 站点分享图片（OG 图片绝对 URL，可选；建议 1200×630）
VITE_SITE_IMAGE=

# 部署基路径（可选；默认 `/` 即站点根部署）
# 应用被挂在域名子路径时填写该前缀，例如 VITE_BASE_URL=/xs-dnd-character-builder/
# 产物内所有资源引用、路由 href、Service Worker 注册、模板与 version.json 都会带上它，
# 反向代理只需把该前缀原样映射到 dist 目录，不要再改写 HTML
VITE_BASE_URL=

# “请杯咖啡”收款码（可选；真实图片放在被 Git 忽略的 public/local-assets/tips/）
VITE_TIP_WECHAT_QR_URL=
VITE_TIP_ALIPAY_QR_URL=

# Umami 访问统计（仅在当前域名包含于 VITE_UMAMI_DOMAINS 时加载）
VITE_UMAMI_SCRIPT_URL=https://your_url/script.js
VITE_UMAMI_WEBSITE_ID=your website id
VITE_UMAMI_DOMAINS=your_url
