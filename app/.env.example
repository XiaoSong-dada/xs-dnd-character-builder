# 站点信息（可选，全部不配置时主页署名行自动隐藏）
# 复制本文件为 .env.local 后按需修改；Vite 从 app/ 目录加载 .env*

# 作者名（主页署名行"由 X 制作"）
VITE_AUTHOR_NAME=小宋哒哒

# GitHub 主页或仓库链接（署名行 GitHub 图标跳转地址）
VITE_GITHUB_URL=https://github.com/XiaoSong-dada

# 可选署名标语（暂未展示，预留）
VITE_AUTHOR_TAGLINE=

# 可选版本号（署名行显示 v0.1.0；未配置则不显示）
VITE_APP_VERSION=0.1.0
