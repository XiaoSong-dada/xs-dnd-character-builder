# Docker Compose 对外端口
APP_PORT=8080

# 可选站点信息
VITE_AUTHOR_NAME=小宋哒哒
VITE_GITHUB_URL=https://github.com/XiaoSong-dada
VITE_AUTHOR_TAGLINE=
VITE_APP_VERSION=1.0.0

# “请杯咖啡”收款码 URL（可选；真实图片由本地部署环境提供）
VITE_TIP_WECHAT_QR_URL=
VITE_TIP_ALIPAY_QR_URL=

# SEO 站点入口（canonical / og:url；只写到站点根，不含部署前缀）
VITE_SITE_URL=https://your_url

# 部署基路径（可选；留空或填 / 表示站点根部署）
# 容器内的 nginx.conf 只按站点根提供静态文件：填了子路径就必须同时改造运行阶段的 nginx，
# 否则产物里的资源会去找带前缀的路径而服务器上没有对应 location
VITE_BASE_URL=

# Umami 访问统计（Vite 构建期注入）
VITE_UMAMI_SCRIPT_URL=https://your_url/script.js
VITE_UMAMI_WEBSITE_ID=your website id
VITE_UMAMI_DOMAINS=your_url
